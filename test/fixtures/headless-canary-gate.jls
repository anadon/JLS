CIRCUIT canary
ELEMENT Constant
 int id 0
 int x 60
 int y 60
 int width 24
 int height 24
 Int value 5
 int base 10
 String orient "RIGHT"
END
ELEMENT AndGate
 int id 1
 int x 240
 int y 120
 int width 48
 int height 24
 int bits 1
 int numInputs 2
 String orientation "right"
 int delay 10
END
ELEMENT OutputPin
 int id 4
 int x 480
 int y 120
 int width 48
 int height 24
 String name "out"
 int bits 1
 int watch 1
 String orient "RIGHT"
END
ELEMENT WireEnd
 int id 2
 int x 120
 int y 72
 String put "output"
 ref attach 0
 ref wire 3
END
ELEMENT WireEnd
 int id 3
 int x 240
 int y 132
 String put "input0"
 ref attach 1
 ref wire 2
END
ENDCIRCUIT
