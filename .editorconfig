# EditorConfig (https://editorconfig.org) — keeps editors consistent with
# the Spotless gate in pom.xml. JLS uses tab indentation historically.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab

# Data/markup files conventionally use spaces.
[*.{xml,yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
